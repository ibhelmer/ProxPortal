# Example only. Place in Nginx's http context (e.g. sites-available on Debian).
# Replace hostname and certificate paths before enabling.
# Query strings and request bodies are deliberately excluded from access logs.
log_format labportal '$remote_addr [$time_local] "$request_method $uri" $status $body_bytes_sent';
server {
    listen 80;
    server_name vmportal.example.org;
    return 301 https://vmportal.example.org$request_uri;
}
server {
    listen 443 ssl;
    server_name vmportal.example.org;
    ssl_certificate /etc/ssl/labportalen/fullchain.pem;
    ssl_certificate_key /etc/ssl/labportalen/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    access_log /var/log/nginx/labportalen-access.log labportal;
    error_log /var/log/nginx/labportalen-error.log warn;
    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host vmportal.example.org;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For "";
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
        proxy_send_timeout 30s;
    }
}
