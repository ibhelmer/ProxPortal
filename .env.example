# Local preview defaults. Run python scripts/setup_env.py to create .env.
SECRET_KEY=CHANGE_ME_GENERATE_A_RANDOM_SECRET
APP_ENV=development
PUBLIC_BASE_URL=http://127.0.0.1:8000
ALLOWED_HOSTS=127.0.0.1,localhost
SECURE_COOKIES=0
DATABASE_PATH=data/labportalen.sqlite3
PORTAL_NAME=ProxPortal
ORGANIZATION=UCN
SUPPORT_EMAIL=
PRIVACY_URL=
# Exact accepted email domains, comma-separated; empty accepts any valid address.
# Domain restriction is NOT identity verification.
ALLOWED_EMAIL_DOMAINS=
# Only exact IPs of your trusted reverse proxy may supply X-Real-IP.
TRUSTED_PROXY_IPS=
MAX_VCPU=64
MAX_RAM_GIB=512
MAX_STORAGE_GIB=8192
MAX_DURATION_DAYS=730
# Shared classroom NAT is taken into account by a higher per-IP submit limit.
SUBMIT_IP_LIMIT=120
SUBMIT_EMAIL_LIMIT=5
LOGIN_IP_LIMIT=10
STATUS_IP_LIMIT=60
# Docker's published port is loopback only.
HTTP_PORT=8000
